# Gemini AI API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Razorpay public Key ID (test in dev, live in prod). Used by the in-app
# Checkout SDK (services/razorpayCheckoutService.ts). The Key SECRET lives
# ONLY in Supabase Functions secrets (RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET) —
# never on the client. Subscription creation / verification happens via the
# Supabase Edge Functions `create-subscription` and `verify-subscription`,
# so the merchant flow no longer depends on the Vercel /subscribe page.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Test-only bypass for the in-app subscription step.
# When 'true', the merchant signup wizard shows an amber "Skip Payment (Test
# Subscription)" button that creates a 30-day free subscription without going
# through real billing. MUST be 'false' (or unset) for production builds.
# Test subscriptions are tagged is_test_subscription=true in the DB so they
# can be cleaned up before launch.
VITE_ALLOW_TEST_SUBSCRIPTION=false

# SECURITY NOTES:
# 1. Never commit .env.local to git
# 2. Restrict Google Maps API key in Google Cloud Console with:
#    - Application restrictions (Android app package name + SHA-1)
#    - API restrictions (only allow required APIs)
# 3. Ensure Supabase has Row Level Security (RLS) enabled on all tables
# 4. Only use anon key on client-side, never service role key
