# Edge function secrets for hyijwfovsvetpyrbqfcd (new shared DEV)
# Fill in values, then:
#   npx supabase secrets set --env-file dev-secrets.env --project-ref hyijwfovsvetpyrbqfcd
#   npx supabase secrets list --project-ref hyijwfovsvetpyrbqfcd
#   Remove-Item dev-secrets.env      <-- DO NOT COMMIT
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by Supabase. Do not set them here.

# ---- TIER 1: values you already have locally ----
# GEMINI_API_KEY: ConsumerPROD/.env.local -> GEMINI_API_KEY
# used by: analyze-product-image, repair-translations
GEMINI_API_KEY=

# RAZORPAY_KEY_ID: MerchantDEV/.env.local -> VITE_RAZORPAY_KEY_ID
# used by: merchant-subscription, process-referral-reward, razorpay-webhook
RAZORPAY_KEY_ID=

# SERPAPI_KEY: MerchantDEV/.env.local -> VITE_SERPAPI_KEY
# used by: product-search
SERPAPI_KEY=

# REVIEWER_PHONES: MerchantDEV/.env.local -> VITE_REVIEWER_PHONES
# used by: merchant-subscription
REVIEWER_PHONES=

# ALLOW_TEST_SUBSCRIPTION: MerchantDEV/.env.local -> VITE_ALLOW_TEST_SUBSCRIPTION
# used by: merchant-subscription
ALLOW_TEST_SUBSCRIPTION=

# ---- TIER 2: re-obtain from the provider dashboard ----
# FIREBASE_PROJECT_ID: Firebase service-account JSON (use a DEV Firebase project)
# used by: manage-friends, send-new-deal-notification, share-deal-with-user
FIREBASE_PROJECT_ID=

# FIREBASE_CLIENT_EMAIL: Firebase service-account JSON
# used by: manage-friends, send-new-deal-notification, share-deal-with-user
FIREBASE_CLIENT_EMAIL=

# FIREBASE_PRIVATE_KEY: Firebase service-account JSON (keep the 
 escapes)
# used by: manage-friends, send-new-deal-notification, share-deal-with-user
FIREBASE_PRIVATE_KEY=

# FIREBASE_SERVICE_ACCOUNT_JSON: the whole Firebase service-account JSON, one line
# used by: send-merchant-push, send-trial-email, web-login-request
FIREBASE_SERVICE_ACCOUNT_JSON=

# RAZORPAY_KEY_SECRET: Razorpay -> Settings -> API Keys (TEST mode)
# used by: merchant-subscription, process-referral-reward, razorpay-webhook, verify-subscription
RAZORPAY_KEY_SECRET=

# RAZORPAY_WEBHOOK_SECRET: Razorpay -> Settings -> Webhooks
# used by: razorpay-webhook
RAZORPAY_WEBHOOK_SECRET=

# CLOUDINARY_CLOUD_NAME: Cloudinary -> Settings -> API Keys
# used by: cloudinary-destroy, cloudinary-sign
CLOUDINARY_CLOUD_NAME=

# CLOUDINARY_API_KEY: Cloudinary -> Settings -> API Keys
# used by: cloudinary-destroy, cloudinary-sign
CLOUDINARY_API_KEY=

# CLOUDINARY_API_SECRET: Cloudinary -> Settings -> API Keys
# used by: cloudinary-destroy, cloudinary-sign
CLOUDINARY_API_SECRET=

# RESEND_API_KEY: Resend -> API Keys (create new; old ones are not re-readable)
# used by: send-support-email, send-trial-email
RESEND_API_KEY=

# RESEND_FROM_EMAIL: must be a domain verified in Resend
# used by: send-support-email, send-trial-email
RESEND_FROM_EMAIL=

# STORAGE_BUCKET_NAME: your choice - match what step 7 creates
# used by: upload-deal-image
STORAGE_BUCKET_NAME=

# ---- TIER 3: KYC. Mock mode for DEV; leave the provider creds blank ----
KYC_PROVIDER=mock
KYC_MOCK_MODE=true

