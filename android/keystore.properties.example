# Copy this file to `keystore.properties` (same android/ folder) and fill in.
# GITIGNORED — never commit keystore.properties or the .jks itself.
#
# storeFile     : absolute path to your release keystore (.jks). Use double
#                 backslashes on Windows, e.g. C:\\Srini\\dealpro\\dealpro-release.jks
# storePassword : the keystore password you set with keytool
# keyAlias      : dealpro-merchant   (this is the MERCHANT app)
# keyPassword   : the key password for that alias (often same as storePassword)

storeFile=C:\\Srini\\dealpro\\dealpro-release.jks
storePassword=CHANGE_ME
keyAlias=dealpro-merchant
keyPassword=CHANGE_ME
