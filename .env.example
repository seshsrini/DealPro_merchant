# ============================================================================
# Merchant app environment
# ============================================================================
# Copy to .env.local and fill in. Every key below is REQUIRED unless marked
# optional — this file was previously missing 12 keys the app actually reads,
# so a fresh setup produced a build with silently broken push, logging and
# subscription links.
#
# PROD = a value that MUST differ between dev and prod. Never copy a dev
# .env.local into a prod checkout; author a fresh one.
# ============================================================================

# ── Supabase ───────────────────────────────────────────────────── PROD ──────
# From Dashboard → Settings → API. Anon key ONLY — the service_role key must
# never appear in a client build.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Google / AI ────────────────────────────────────────────────── PROD ──────
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Product lookup / enrichment during catalogue creation.
VITE_SERPAPI_KEY=your_serpapi_key_here

# ── Firebase (push notifications / FCM) ────────────────────────── PROD ──────
# Use a SEPARATE Firebase project for prod, or dev and prod devices share FCM
# tokens and test pushes reach real merchants.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=<project>.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ── Billing / Razorpay ─────────────────────────────────────────── PROD ──────
# Public Key ID only (rzp_test_… in dev, rzp_live_… in prod). The Key SECRET
# lives ONLY in Supabase Function secrets (RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET).
# Subscription create/verify runs through the `create-subscription` and
# `verify-subscription` edge functions.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Test-only bypass for the in-app subscription step. When 'true' the signup
# wizard shows a "Skip Payment (Test Subscription)" button granting 30 days free.
# MUST be 'false' (or unset) in production builds. Test subscriptions are tagged
# is_test_subscription=true so they can be cleaned up before launch.
VITE_ALLOW_TEST_SUBSCRIPTION=false

# ── Play Store compliance ──────────────────────────────────────── PROD ──────
# 'true' for the build shipped on the Play Store (see services/playCompliance.ts).
VITE_PLAY_COMPLIANT=false

# Hosted subscription pages on vedicjaalam.com. There are TWO LANES, and the
# naming is easy to misread — note the polarity:
#
#   /subscribe        -> LIVE  lane: live Razorpay keys + PROD Supabase project
#   /test_subscribe   -> TEST  lane: test Razorpay keys + DEV  Supabase project
#   /merchant/subscribe          -> LIVE manage-subscription
#   /merchant/subscribe?test=1   -> TEST manage-subscription
#
# ⚠ Both vars DEFAULT to the LIVE URLs when unset, so an unconfigured dev build
# hits real billing. Always set them explicitly.
#
#   DEV  builds:
#     VITE_SUBSCRIBE_URL=https://vedicjaalam.com/test_subscribe
#     VITE_MANAGE_SUBSCRIPTION_URL=https://vedicjaalam.com/merchant/subscribe?test=1
#   PROD builds:
#     VITE_SUBSCRIBE_URL=https://vedicjaalam.com/subscribe
#     VITE_MANAGE_SUBSCRIPTION_URL=https://vedicjaalam.com/merchant/subscribe
#
# The lane is chosen server-side in the web app (getSupabaseAdmin(test) and the
# Razorpay test/live key pair), so the two lanes never share data or keys.
VITE_SUBSCRIBE_URL=https://vedicjaalam.com/test_subscribe
VITE_MANAGE_SUBSCRIPTION_URL=https://vedicjaalam.com/merchant/subscribe?test=1

# ── Sentry (error reporting) ─────────────────────────── optional / PROD ─────
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Never commit .env.local to git.
# 2. Restrict the Google Maps key in Google Cloud Console:
#    - Application restrictions (Android package name + SHA-1)
#    - API restrictions (only the APIs actually used)
# 3. Ensure Row Level Security is enabled on every table holding user data.
# 4. Only the anon key belongs on the client — never the service_role key.
